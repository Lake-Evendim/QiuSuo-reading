3b20faec8c4e78e10c7d6ca03ef37b0771aeda8bc4553e8cd3aff5122b29b1318@finder-1793759029756389-637975615\" data-status=\"0\" data-parentwidth=\"677\" data-maxwidth=\"677\" data-index=\"0\" data-flag=\"0\" data-reservation=\"0\"></mp-common-videosnap></section><p data-pm-slice=\"0 0 []\" style=\"line-height: 2em;text-align: justify;margin-bottom: 24px;margin-top: 0px;\"><span leaf=\"\" style=\"color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, &quot;PingFang SC&quot;, system-ui, -apple-system, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;\"><span textstyle=\"\" style=\"font-size: 15px;letter-spacing: 1px;\">近</span></span><span leaf=\"\" style=\"line-height: 2em;text-align: justify;color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, &quot;PingFang SC&quot;, system-ui, -apple-system, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;\"><span textstyle=\"\" style=\"font-size: 15px;letter-spacing: 1px;\">年来，</span></span><strong style=\"line-height: 2em;text-align: justify;color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, &quot;PingFang SC&quot;, system-ui, -apple-system, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;\" data-pm-slice=\"0 0 []\"><span leaf=\"\" style=\"color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, &quot;PingFang SC&quot;, system-ui, -apple-system, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;\"><span textstyle=\"\" style=\"font-size: 15px;letter-spacing: 1px;\">物</span></span></strong><span leaf=\"\" style=\"color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, &quot;PingFang SC&quot;, system-ui, -apple-system, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;\"><span textstyle=\"\" style=\"font-size: 15px;letter-spacing: 1px;\">理AI与具身智能加速发展，</span></span><strong style=\"line-height: 2em;text-align: justify;color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, &quot;PingFang SC&quot;, system-ui, -apple-system, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;\" data-pm-slice=\"0 0 []\"><span leaf=\"\" style=\"color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, &quot;PingFang SC&quot;, system-ui, -apple-system, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;\" data-pm-slice=\"1 1 [&quot;para&quot;,{&quot;tagName&quot;:&quot;p&quot;,&quot;attributes&quot;:{&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;line-height: 2em;text-align: justify;margin-bottom: 24px;margin-top: 0px;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;,&quot;data-layout-id&quot;:null},&quot;node&quot;,{&quot;tagName&quot;:&quot;strong&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;line-height: 2em;text-align: justify;color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, \\&quot;PingFang SC\\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \\&quot;Helvetica Neue\\&quot;, \\&quot;Hiragino Sans GB\\&quot;, \\&quot;Microsoft YaHei UI\\&quot;, \\&quot;Microsoft YaHei\\&quot;, Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]\"><span textstyle=\"\" style=\"font-size: 15px;letter-spacing: 1px;\">GPT6 Astra等新一代大模型发布，</span></span></strong><span leaf=\"\" style=\"color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, &quot;PingFang SC&quot;, system-ui, -apple-system, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;\"><span textstyle=\"\" style=\"font-size: 15px;letter-spacing: 1px;\">端到端学习、视觉—语言—动作模型（VLA）、世界模型等技术路线不断演进，AI 与物理世界的交互方式持</span></span><span leaf=\"\" style=\"line-height: 2em;text-align: justify;color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, &quot;PingFang SC&quot;, system-ui, -apple-system, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;\"><span textstyle=\"\" style=\"font-size: 15px;letter-spacing: 1px;\">续拓宽。</span></span><strong style=\"line-height: 2em;text-align: justify;color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, &quot;PingFang SC&quot;, system-ui, -apple-system, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;\" data-pm-slice=\"0 0 []\"><span leaf=\"\" style=\"color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, &quot;PingFang SC&quot;, system-ui, -apple-system, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;\"><br></span></strong></p><p data-pm-slice=\"0 0 []\" style=\"line-height: 2em;text-align: justify;margin-bottom: 24px;margin-top: 0px;\"><strong style=\"line-height: 2em;text-align: justify;color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, &quot;PingFang SC&quot;, system-ui, -apple-system, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;\" data-pm-slice=\"0 0 []\"><span leaf=\"\" style=\"color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, &quot;PingFang SC&quot;, system-ui, -apple-system, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;\"><span textstyle=\"\" style=\"font-size: 15px;letter-spacing: 1px;\">其中，智源研究院将世界模型视为从数字世界通向物理世界的下一代基座模型。基于这一判断，智源提出了四类世界模型分类，并正积极尝试第五条技术路线，以潜空间表征真实物理世界。</span></span></strong></p><p data-pm-slice=\"0 0 []\" style=\"line-height: 2em;text-align: justify;margin-bottom: 24px;margin-top: 0px;\"><span leaf=\"\" style=\"color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, &quot;PingFang SC&quot;, system-ui, -apple-system, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;\"><span textstyle=\"\" style=\"font-size: 15px;letter-spacing: 1px;\">当</span></span><span leaf=\"\" style=\"color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, &quot;PingFang SC&quot;, system-ui, -apple-system, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;\"><span textstyle=\"\" style=\"font-size: 15px;letter-spacing: 1px;\">AI</span></span><span leaf=\"\" style=\"color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, &quot;PingFang SC&quot;, system-ui, -apple-system, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;\"><span textstyle=\"\" style=\"font-size: 15px;letter-spacing: 1px;\">从数字世界走向物理世界，走进大众的生活流和工作流，能否真正理解环境、有效行动，并在复杂场景中持续适应与进化，仍是行业面临的核心挑战。喧嚣背后，各家方案大多只在特定场景里验证过效果，技术能力难以横向对标；前沿技术与产业的真实需求之间，也还隔着一道适配的坎，行业至今缺少公认的衡量标尺。</span></span></p><p data-pm-slice=\"0 0 []\" style=\"line-height: 2em;text-align: justify;margin-bottom: 24px;margin-top: 0px;\"><span leaf=\"\" style=\"color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, &quot;PingFang SC&quot;, system-ui, -apple-system, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;\"><span textstyle=\"\" style=\"font-size: 15px;letter-spacing: 1px;\">归根结底，</span><span textstyle=\"\" style=\"font-size: 15px;letter-spacing: 1px;color: rgb(0, 82, 255);font-weight: bold;\">物理 AI 的智能水平究竟该如何评估？</span></span></p><p style=\"line-height: 2em;text-align: justify;margin-bottom: 24px;margin-top: 0px;\"><span leaf=\"\" style=\"color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, &quot;PingFang SC&quot;, system-ui, -apple-system, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;\"><span textstyle=\"\" style=\"font-size: 15px;letter-spacing: 1px;\">为回应这一核心问题，北京智源人工智能研究院将于</span></span><strong><span leaf=\"\" style=\"color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, &quot;PingFang SC&quot;, system-ui, -apple-system, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;\"><span textstyle=\"\" style=\"font-size: 15px;letter-spacing: 1px;color: rgb(0, 82, 255);font-weight: bold;\">2026年11月24日</span></span></strong><span leaf=\"\" style=\"color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, &quot;PingFang SC&quot;, system-ui, -apple-system, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;\"><span textstyle=\"\" style=\"font-size: 15px;letter-spacing: 1px;\">，举办</span></span><strong><span leaf=\"\" style=\"color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, &quot;PingFang SC&quot;, system-ui, -apple-system, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;\"><span textstyle=\"\" style=\"font-size: 15px;letter-spacing: 1px;color: rgb(0, 82, 255);font-weight: bold;\">智源REAL物理AI开放日</span></span></strong><span leaf=\"\" style=\"color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, &quot;PingFang SC&quot;, system-ui, -apple-system, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;letter-spacing: 0.034em;font-style: normal;font-weight: normal;\"><span textstyle=\"\" style=\"font-size: 15px;letter-spacing: 1px;\">。本次开放日主张客观呈现技术进步，以真实丈量智能差距，引领物理AI 发展，推动行业从预期驱动走向实证驱动。</span></span></p><section style=\"text-align: left;justify-content: flex-start;display: flex;flex-flow: row;margin: -20px 0px 10px;width: 100%;align-self: flex-start;background-color: rgb(247, 251, 254);padding: 33px 22px 22px;box-sizing: border-box;\"><section style=\"text-align: center;width: 100%;box-sizing: border-box;\" data-pm-slice=\"3 3 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;margin: -20px 0px 10px;width: 100%;align-self: flex-start;background-color: rgb(247, 251, 254);padding: 33px 22px 22px;box-sizing: border-box;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;,&quot;data-layout-id&quot;:null}]\"><p style=\"line-height: 2em;margin-bottom: 24px;margin-top: 0px;\"><span leaf=\"\" style=\"font-weight: bold;\"><span textstyle=\"\" style=\"font-size: 16px;letter-spacing: 1px;color: rgb(0, 82, 255);\">活动亮点</span></span></p><section style=\"line-height: 1em;text-align: left;margin-bottom: 24px;margin-top: 0px;\"><span leaf=\"\"><span textstyle=\"\" style=\"font-size: 15px;letter-spacing: 1px;font-weight: bold;\">▸&nbsp;</span></span><span leaf=\"\" style=\"font-weight: bold;\"><span textstyle=\"\" style=\"font-size: 15px;letter-spacing: 1px;font-weight: bold;\">重磅评测发布</span><span textstyle=\"\" style=\"font-size: 15px;letter-spacing: 1px;\">：衡量物理AI智能的标尺</span></span></section><p style=\"line-height: 1em;text-align: left;margin-bottom: 24px;margin-top: 0px;\"><span leaf=\"\"><span textstyle=\"\" style=\"font-size: 15px;letter-spacing: 1px;font-weight: bold;\">▸&nbsp;</span></span><span leaf=\"\" style=\"color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, &quot;PingFang SC&quot;, system-ui, -apple-system, BlinkMacSystemFont, &quot;Helvet